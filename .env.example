# --- Discord ---
# Token del bot: https://discord.com/developers/applications -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# --- Precios de Cardmarket ---
# La API oficial está CERRADA a nuevas altas, sin fecha de reapertura. En su lugar
# se usa un proveedor gratuito (sin tarjeta):
#
#   BERRYWALLET_API_KEY -> precios de Cardmarket en EUR (Trend/Media/Mínimo).
#      Gratis (100 req/h, 1000/día, sin tarjeta). Consigue tu clave en
#      https://pokewallet.io/dashboard. No incluye desglose por país.
#
#   RAPIDAPI_KEY (OPCIONAL) -> comparativa por país España. Requiere tarjeta en
#      RapidAPI, por lo que por defecto se deja vacía.
#
# PRICE_PROVIDER=auto  -> berrywallet (si hay clave) > rapidapi (si hay clave) > cardmarket (si credenciales)
# Otros valores: berrywallet | rapidapi | cardmarket
#
# (Opcional, futuro) Si algún día la API oficial vuelve a aceptar acceso, rellena
# estos 4 tokens de https://www.cardmarket.com/es/Account/MyApplications y pon
# PRICE_PROVIDER=cardmarket para recuperar el filtro exacto por idioma inglés + país.
PRICES_ENABLED=1
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=
BERRYWALLET_API_KEY=
RAPIDAPI_KEY=
PRICE_PROVIDER=auto

# --- optcg-api (recomendado para /listado con filtros ricos) ---
# La instancia pública está restringida: pide acceso no comercial en
# https://github.com/arjunkai/optcg-api (issue/email) o despliega tu propia
# instancia y apunta aquí. Sin clave, /buscar cae a fallback por nombre.
OPTCG_API_URL=https://optcg-api.arjunbansal-ai.workers.dev
OPTCG_API_KEY=

