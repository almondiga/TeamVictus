# --- Discord ---
# Token del bot: https://discord.com/developers/applications -> tu app -> Bot -> Reset Token
DISCORD_TOKEN=

# --- Precios de Cardmarket ---
# ⚠️ La API oficial de Cardmarket está CERRADA a nuevas altas (sin fecha de reapertura),
# por lo que los precios se obtienen de proveedores alternativos:
#
#   A) BERRYWALLET_API_KEY -> precios de Cardmarket en EUR (Trend/Media/Mínimo).
#      Gratis (100 req/h, 1000/día). Consigue tu clave en https://pokewallet.io/dashboard
#      No incluye desglose por país.
#
#   B) RAPIDAPI_KEY -> añade la comparativa por país: mínimo near-mint de vendedores
#      de España. Suscríbete al plan FREE de "CardMarket API TCG" en rapidapi.com
#      y copia tu clave. Plan free: 100 req/día.
#
# PRICE_PROVIDER=auto  -> berrywallet (si hay clave) > rapidapi (si hay clave) > cardmarket (si credenciales)
# Otros valores: berrywallet | rapidapi | cardmarket
#
# (Opcional, futuro) Si algún día la API oficial vuelve a aceptar acceso, rellena
# estos 4 tokens de https://www.cardmarket.com/es/Account/MyApplications y pon
# PRICE_PROVIDER=cardmarket para recuperar el filtro exacto por idioma inglés + país.
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=
BERRYWALLET_API_KEY=
RAPIDAPI_KEY=
PRICE_PROVIDER=auto

# --- optcg-api (opcional; añade variantes ricas y precios USD) ---
# La instancia pública está restringida: pide acceso no comercial en
# https://github.com/arjunkai/optcg-api (issue/email) o despliega tu propia
# instancia y apunta aquí.
OPTCG_API_URL=https://optcg-api.arjunbansal-ai.workers.dev
OPTCG_API_KEY=

# --- Catálogo local de cartas (recomendado: sin claves de nadie) ---
# Genera optcg_cards.db ejecutando build_local_db.py tras correr el scraper del
# proyecto optcg-api (MIT) contra el sitio oficial de Bandai (ver README).
# Si el archivo existe, el bot lo usa automáticamente para /buscar y /listado
# (catálogo completo, sin red) antes que optcg-api/BerryWallet.
LOCAL_DB_PATH=optcg_cards.db

# --- Opcional ---
# DB_PATH=optcg_bot.db
